[Unit]
Description=VoiceOS Vault daily snapshot
After=network.target vault.service

[Service]
Type=oneshot
User=voiceos
EnvironmentFile=/etc/voiceos/cpu.env
ExecStart=/bin/bash /opt/voiceos/scripts/backup/vault_snapshot.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voiceos-vault-snapshot
