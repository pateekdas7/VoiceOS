[Unit]
Description=VoiceOS Voice Runtime (Twilio Media Streams WS)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/voiceos/app
EnvironmentFile=/opt/voiceos/.env
ExecStart=/opt/voiceos/venv/bin/python deployment/cpu/app.py --serve
Restart=always
RestartSec=10
TimeoutStopSec=45
StandardOutput=append:/opt/voiceos/logs/voice-runtime.log
StandardError=append:/opt/voiceos/logs/voice-runtime.log

[Install]
WantedBy=multi-user.target
