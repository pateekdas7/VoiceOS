# ==============================================================================
# VoiceOS CPU Node — Environment Variable Template
# Copy to .env and fill in real values from your secrets manager.
# NEVER commit .env with real values.
# ==============================================================================

# ── Service environment ────────────────────────────────────────────────────────
SERVICE_ENV=production
LOG_LEVEL=INFO

# ── Redis (Sprint-019+: value fetched from Vault at runtime — no hardcoded values) ──
REDIS_HOST=redis.voiceos-data.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ── EventBus (Sprint-013 — Redis Streams) ────────────────────────────────────
# EVENT_BUS_STREAM: the primary domain-event stream (XADD/XREADGROUP target).
# EVENT_BUS_DLQ: dead-letter stream — events failing EVENT_BUS_MAX_RETRIES
#   processing attempts are routed here with full failure context. Naming:
#   dlq:{stream_name} (the "dlq:" prefix form used throughout Sprint-013.md's
#   deployment procedure / health checks / DR validation — the codebase's
#   DLQHandler derives this automatically from EVENT_BUS_STREAM).
# EVENT_BUS_CONSUMER_GROUP: the shared consumer group name every service
#   instance joins for parallel, at-least-once consumption.
EVENT_BUS_STREAM=voiceos-events
EVENT_BUS_DLQ=dlq:voiceos-events
EVENT_BUS_CONSUMER_GROUP=main-group
EVENT_BUS_MAX_RETRIES=3

# ── PostgreSQL (Sprint-019+: value fetched from Vault at runtime — no hardcoded values) ──
POSTGRES_HOST=postgres.voiceos-data.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=voiceos
POSTGRES_USER=voiceos
POSTGRES_PASSWORD=CHANGE_ME

# ── MongoDB (Sprint-019+: value fetched from Vault at runtime — no hardcoded values) ──
MONGO_URI=mongodb://voiceos:CHANGE_ME@mongo.voiceos-data.svc.cluster.local:27017/voiceos

# ── GPU Node ──────────────────────────────────────────────────────────────────
# GPU_NODE_HOST: used as fallback when per-service URLs are not set.
# Phase-5 / Kaggle integration: set the three *_BASE_URL vars instead —
# Kaggle notebooks expose each service via a separate Cloudflare Quick Tunnel
# (run "CELL TUNNEL" in the notebook to get these URLs).
# Direct-IP deployments (dedicated GPU server): set only GPU_NODE_HOST;
# *_BASE_URL vars can be left unset.
GPU_NODE_HOST=CHANGE_ME
# LLM_BASE_URL=https://<random>.trycloudflare.com   # Phase-5: Kaggle LLM tunnel
# STT_BASE_URL=https://<random>.trycloudflare.com   # Phase-5: Kaggle STT tunnel
# TTS_BASE_URL=https://<random>.trycloudflare.com   # Phase-5: Kaggle TTS tunnel
GPU_SCHEDULER_URL=http://gpu-scheduler.voiceos-runtime.svc.cluster.local:8084

# ── CRM / Collections (Sprint-022, V5 Ch4/Ch5) ────────────────────────────────
# CRMService (CustomerService, CustomerContextAssembler) and CollectionsService
# (LoanAccountService, PromiseToPayService, SettlementService, CallbackScheduler,
# EscalationWorkflow) are library classes consumed in-process by
# ConversationEngine — no standalone HTTP listener exists yet (same "library
# class" state as every service since Sprint-013; see CPU_NODE_STATE.md §8.1).
# These URLs are reserved for the Sprint-026 K8s/Helm rollout.
CRM_SERVICE_URL=http://crm-service.voiceos-platform.svc.cluster.local:8106
COLLECTIONS_SERVICE_URL=http://collections-service.voiceos-platform.svc.cluster.local:8107

# ── Campaign Management / Contact Center / HITL (Sprint-023, V5 Ch6/Ch7; V4 Ch15) ──
# CampaignManagementService (CampaignService/ScheduleEngine/ABTestingFramework/
# AudienceSelector/CallDispatcher), ContactCenterService (SkillsBasedRouter/
# LiveTransferService/SupervisorService), and HITLService (HITLQueue/
# SLAEnforcer/HumanReviewAPI/OverrideLogger/HITLDashboard) are library classes
# consumed in-process — no standalone HTTP listener exists yet (same "library
# class" state as every service since Sprint-013; see CPU_NODE_STATE.md §8.1).
# These URLs are reserved for the Sprint-026 K8s/Helm rollout.
CAMPAIGN_MGMT_URL=http://campaign-management-service.voiceos-platform.svc.cluster.local:8108
CONTACT_CENTER_URL=http://contact-center-service.voiceos-platform.svc.cluster.local:8109
HITL_SERVICE_URL=http://hitl-service.voiceos-platform.svc.cluster.local:8110
# HITL SLA tiers (Sprint-023.md's own values — not sourced from Volume 4, see
# CHANGELOG.md's Sprint-023 Deviations): CRITICAL=5min, HIGH=30min, MEDIUM=240min.
HITL_SLA_CRITICAL_MINUTES=5
HITL_SLA_HIGH_MINUTES=30
HITL_SLA_MEDIUM_MINUTES=240

# ── Auth (Sprint-018, V4 Ch5) ─────────────────────────────────────────────────
# JWTValidator verifies RS256 signatures with a *public* key only (never a
# signing secret — src/services/auth/jwt_validator.py) so a compromised
# service process can never mint tokens. JWT_SECRET is retained for any
# future symmetric-algorithm deployment mode (not used by this sprint's
# implementation); JWT_PUBLIC_KEY_PATH is what JWTValidator actually reads.
JWT_SECRET=CHANGE_ME
JWT_PUBLIC_KEY_PATH=/opt/voiceos/certs/jwt_public_key.pem
JWT_ISSUER=CHANGE_ME
JWT_AUDIENCE=voiceos
JWT_EXPIRY_SECONDS=3600

# ── API Keys (Sprint-018, V4 Ch5) ─────────────────────────────────────────────
# APIKeyValidator never stores or compares raw keys — only their SHA-256
# digest (src/services/auth/api_key_validator.py). No value belongs here;
# keys are issued/registered against the (future) Postgres-backed key store.

# ── Authorization (Sprint-018, V4 Ch6) ────────────────────────────────────────
# JIT_PRIVILEGE_REQUIRED_APPROVALS: minimum distinct approvers for a
#   time-boxed role escalation (src/services/authz/jit_privilege.py).
# JIT_PRIVILEGE_DEFAULT_TTL_SECONDS: default grant lifetime.
JIT_PRIVILEGE_REQUIRED_APPROVALS=2
JIT_PRIVILEGE_DEFAULT_TTL_SECONDS=3600

# ── AI Governance (Sprint-018, V4 Ch3) ────────────────────────────────────────
# AI_GOVERNANCE_HUMAN_REVIEW_THRESHOLD: risk_score at/above which a turn is
#   routed to REQUIRE_HUMAN instead of APPROVE/BLOCK
#   (src/services/ai_governance/governance_layer.py).
AI_GOVERNANCE_HUMAN_REVIEW_THRESHOLD=0.9

# ── Vault (Sprint-019) ────────────────────────────────────────────────────────
# Self-hosted HashiCorp Vault on this node (no cloud Vault/KMS account exists
# for this project — same self-managed-infrastructure precedent as
# Sprint-018's mTLS CA). KV v2 mounted at `secret/` holds application
# secrets (postgres/redis/mongodb passwords); the Transit engine mounted at
# `transit/` is the KMS backend for envelope encryption (one KEK per
# tenant, named `tenant-<tenant_id>`) — see src/libs/encryption/kms_client.py
# ::VaultTransitKMSClient. VAULT_TOKEN is a `voiceos-app`-policy-scoped
# token (see scripts/db/encrypt_pii_backfill.py's usage), not the root token.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=CHANGE_ME

# ── KMS (Sprint-019) ──────────────────────────────────────────────────────────
# No AWS/GCP account exists for this project — the KMS backend is Vault's
# own Transit engine (see VAULT_ADDR above), via VaultTransitKMSClient.
# AWSKMSAdapter (src/libs/encryption/kms_client.py) is implemented for a
# future cloud deployment but not wired anywhere on this node.
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ── Tenant KMS (Sprint-021) ────────────────────────────────────────────────────
# Sprint-021.md's own illustrative deployment procedure names KMS_ENDPOINT/
# KMS_KEY_ARN_TEMPLATE — this project resolved the KMS-substitute question
# in Sprint-019 (self-hosted Vault Transit, no cloud KMS account). Tenant
# KEKs (`TenantProvisioner.provision()`) reuse VAULT_ADDR/VAULT_TOKEN above;
# no separate KMS_ENDPOINT variable exists to avoid a redundant config path.

# ── mTLS (Sprint-018, V4 Ch5 §5.4) ────────────────────────────────────────────
# Provisioned by `python3 scripts/pki/generate_mtls_certs.py` (self-managed
# internal PKI — no external CA). MTLS_CA_CERT_PATH is the CA MTLSEnforcer
# verifies every presented client certificate against; MTLS_CLIENT_CERT_PATH/
# MTLS_CLIENT_KEY_PATH are *this* service's own leaf cert/key when it acts as
# a client calling another service (each service gets its own leaf cert —
# see /opt/voiceos/certs/<service-name>.{crt,key} — set these two to the
# pair matching the service this .env is deployed for).
MTLS_CA_CERT_PATH=/opt/voiceos/certs/ca.crt
MTLS_CLIENT_CERT_PATH=/opt/voiceos/certs/client.crt
MTLS_CLIENT_KEY_PATH=/opt/voiceos/certs/client.key

# ── Observability (Sprint-016 — OTelTracer; full Prometheus/Grafana/Jaeger stack Sprint-027) ──
# OTEL_EXPORTER_OTLP_ENDPOINT: OTLP/HTTP collector endpoint OTelTracer.for_production()
#   exports finished spans to (src/libs/observability/tracer.py). No collector is
#   deployed on this node yet (Sprint-027) — the tracer's BatchSpanProcessor
#   exports asynchronously and never blocks the turn path if the endpoint is
#   unreachable, so this can be safely set ahead of the collector's arrival.
# SERVICE_NAME: this process's `service.name` resource attribute — every
#   service sets its own value (e.g. "voiceos-conversation-engine",
#   "voiceos-llm-runtime") so spans/logs are attributable per V3 Ch16/Ch17.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
SERVICE_NAME=voiceos-conversation-engine

# ── Circuit Breakers (Sprint-016, V3 Ch14) ───────────────────────────────────
# Per-service breaker defaults (STT/LLM/TTS/Postgres/Redis/MongoDB each get
# their own CircuitBreaker instance — see src/libs/circuit_breaker/breaker.py).
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=30
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# ── Policy Engine (Sprint-017, V4 Ch4) ───────────────────────────────────────
# POLICY_ENGINE_URL: reserved for the PolicyEngineService HTTP/gRPC endpoint
#   once it gets a standalone listener (Sprint-026 K8s/Helm — see
#   CPU_NODE_STATE.md §8.1). Until then, PolicyEngineService is an in-process
#   library class (src/services/policy_engine/service.py) consulted directly
#   by ConversationEngine/DialoguePolicyEngine — this URL is not yet dialed
#   by any caller, but is defined now so Sprint-026's service wiring is a
#   config change, not a code change.
# POLICY_CACHE_TTL_SECONDS: TTL applied to each scope's cached compiled
#   rule-id list in Redis (V4 Ch4 §4.13 decision_cache_ttl_s).
POLICY_ENGINE_URL=http://policy-engine.voiceos-runtime.svc.cluster.local:8093
POLICY_CACHE_TTL_SECONDS=30

# PROMETHEUS_ENDPOINT=http://prometheus.voiceos-ops.svc.cluster.local:9090
# GRAFANA_ENDPOINT=http://grafana.voiceos-ops.svc.cluster.local:3000
# JAEGER_ENDPOINT=http://jaeger.voiceos-ops.svc.cluster.local:16686

# ── Billing / Usage Metering / Analytics / Reporting / BI Platform (Sprint-024,
#    V5 Ch9/Ch10/Ch11/Ch12/Ch21) ─────────────────────────────────────────────
# BillingService (SubscriptionManager/EntitlementEngine/InvoiceGenerator/
# PaymentProcessor), MeteringService (UsageCollector/UsageAggregator/
# UsageLimitEnforcer), AnalyticsService, ReportingService, and
# BIPlatformService are library classes consumed in-process — no standalone
# HTTP listener exists yet (same "library class" state as every service
# since Sprint-013; see CPU_NODE_STATE.md §8.1). These URLs are reserved for
# the Sprint-026 K8s/Helm rollout.
BILLING_SERVICE_URL=http://billing-service.voiceos-platform.svc.cluster.local:8111
METERING_SERVICE_URL=http://metering-service.voiceos-platform.svc.cluster.local:8112
ANALYTICS_SERVICE_URL=http://analytics-service.voiceos-platform.svc.cluster.local:8113
REPORTING_SERVICE_URL=http://reporting-service.voiceos-platform.svc.cluster.local:8114
BI_PLATFORM_SERVICE_URL=http://bi-platform-service.voiceos-platform.svc.cluster.local:8115

# ── Admin Portal / AI Configuration / Integration Platform / API Platform
# (Sprint-025, V5 Ch13/Ch14/Ch15/Ch16) ────────────────────────────────────────
# All four are library classes today (no standalone HTTP listener until
# Sprint-026 wires K8s/uvicorn) — these URLs are the intended cluster-internal
# addresses once that lands, not read by any code today.
ADMIN_PORTAL_URL=http://admin-portal-service.voiceos-platform.svc.cluster.local:8116
API_PLATFORM_URL=http://api-platform-service.voiceos-platform.svc.cluster.local:8119
# Per-tenant webhook HMAC secrets are generated at registration time
# (WebhookService.register_endpoint(), secrets.token_hex(32)) and stored in
# webhook_registrations.secret — this template documents the naming
# convention for any future Vault-backed rotation, it is not read directly.
WEBHOOK_SECRET_TEMPLATE=voiceos/webhook-secret/<tenant_id>/<webhook_id>

# ── Payment gateway (Sprint-024, V5 Ch9 — PaymentProcessor stub) ─────────────
# Stripe/Razorpay stubs only — no real gateway account exists for this
# project (same self-managed/no-cloud-account precedent as Sprint-018's mTLS
# CA and Sprint-019's self-hosted Vault). PaymentProcessor.charge() always
# succeeds without these values set (src/services/billing/payment.py); they
# are placeholders for a future real-gateway integration, not read by any
# code today.
STRIPE_SECRET_KEY=CHANGE_ME
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME

# ── Observability Stack (Sprint-027, V7 Ch7-10) ──────────────────────────────
# In-cluster Service DNS endpoints (voiceos-ops namespace) — used by
# deployment/cpu/healthcheck.sh and any operator tooling that needs to reach
# the stack directly rather than via `kubectl port-forward`.
PROMETHEUS_ENDPOINT=http://prometheus.voiceos-ops.svc.cluster.local:9090
GRAFANA_ENDPOINT=http://grafana.voiceos-ops.svc.cluster.local:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.voiceos-ops.svc.cluster.local:4317
JAEGER_ENDPOINT=http://jaeger-query.voiceos-ops.svc.cluster.local:16686
# Grafana admin password is Vault-backed (secret/voiceos/grafana_admin,
# scripts/vault/provision_datastore_auth.sh-style pattern) — never set here;
# infra/k8s/observability/deploy.sh reads it from Vault at deploy time.
# GRAFANA_ADMIN_PASSWORD is intentionally not listed as a settable var.

# ── Alerting (Sprint-027, V7 Ch8) ─────────────────────────────────────────────
# No real PagerDuty/Jira/Slack account exists for this project (same
# "no real account, documented stub" precedent as the Payment gateway
# section above) — infra/k8s/observability/deploy.sh falls back to an
# obvious placeholder value when these are unset, so Alertmanager itself
# still starts; routing to a real destination requires setting these.
PAGERDUTY_SERVICE_KEY=CHANGE_ME
JIRA_WEBHOOK_URL=CHANGE_ME
SLACK_WEBHOOK_URL=CHANGE_ME

# ── Object storage (Sprint-019) ───────────────────────────────────────────────
# No S3/GCS account exists for this project — audio recordings are stored
# on local disk via src/libs/privacy/object_store.py::LocalDiskObjectStore.
RECORDINGS_DIR=/opt/voiceos/recordings
# S3_BUCKET_RECORDINGS=voiceos-recordings-prod
# S3_BUCKET_EXPORTS=voiceos-exports-prod
# S3_REGION=ap-south-1

# ── PII Protection / Audit / Compliance (Sprint-020, V4 Ch10/Ch11/Ch16) ───────
# Retention window for audit_log rows before archival/tiering (V4 Ch11 §11.13
# documents a 7y regulated retention window for the *regulated* subset —
# this variable governs the operational hot-storage retention pass, not the
# regulatory minimum itself).
AUDIT_LOG_RETENTION_DAYS=30
# DPDP/RBI: whether a customer consent record is required before a call may
# proceed past the greeting (V4 Ch2 §"DPDP"; enforced today by the
# DPDPPolicyPack's DPDP-CONSENT-REQUIRED rule regardless of this flag — this
# variable documents the policy intent for operators reading this file).
CONSENT_REQUIRED=true
