# ==============================================================================
# VoiceOS GPU Node — Environment Variable Template
# Copy to .env and fill in real values from your secrets manager.
# NEVER commit .env with real values.
# ==============================================================================

# ── GPU configuration ─────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
# 0.55 (not 0.70): vLLM must leave room for Veena 3B BF16 (~7,980 MB) on the 23 GB L4.
GPU_MEMORY_FRACTION=0.55

# ── Model paths ───────────────────────────────────────────────────────────────
WHISPER_MODEL_PATH=/opt/voiceos-gpu/models/whisper-large-v3-turbo
QWEN_MODEL_PATH=/opt/voiceos-gpu/models/qwen2.5-7b-fp8
VEENA_MODEL_PATH=/opt/voiceos-gpu/models/veena-fp16
SNAC_MODEL_PATH=/opt/voiceos-gpu/models/snac-24khz

# ── Service ports ─────────────────────────────────────────────────────────────
STT_SERVICE_PORT=8100
LLM_SERVICE_PORT=8000
TTS_SERVICE_PORT=8200

# ── CPU node communication ────────────────────────────────────────────────────
GPU_SCHEDULER_REPORT_URL=http://CHANGE_ME:8084
REDIS_URL=redis://:CHANGE_ME@CHANGE_ME:6379/0

# ── HuggingFace (for model downloads) ────────────────────────────────────────
HF_TOKEN=CHANGE_ME
HF_HOME=/opt/voiceos-gpu/cache/hf

# ── Internal model registry (for Veena) ──────────────────────────────────────
MODEL_REGISTRY_URL=https://models.voiceos.internal
MODEL_REGISTRY_TOKEN=CHANGE_ME

# ── Vault (Sprint-019) ────────────────────────────────────────────────────────
# Points at the self-hosted Vault instance on the CPU node (127.0.0.1:8200
# there; reachable from the GPU node via the CPU node's network address —
# no Vault instance runs on this node). Not yet consulted by any GPU
# service (STT/LLM/TTS adapters still read model-serving config directly);
# reserved for a future sprint's GPU-side secrets wiring.
VAULT_ADDR=http://<cpu-node-ip>:8200
VAULT_TOKEN=CHANGE_ME

# ── Observability (Sprint-027+) ───────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://CHANGE_ME:4317
# SERVICE_NAME=gpu-inference-node

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=/opt/voiceos-gpu/logs
