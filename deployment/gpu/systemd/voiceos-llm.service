[Unit]
Description=VoiceOS LLM Inference Server (Qwen2.5-7B-FP8 via vLLM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/voiceos-gpu
EnvironmentFile=-/opt/voiceos-gpu/.env
# vLLM serves the LLM on port 8000.
# --gpu-memory-utilization 0.45: vLLM takes ~10,365 MiB of the 23,034 MiB L4.
# Remaining budget: Veena 3B BF16+SNAC (~8,558 MiB) + Whisper (~1,260 MiB model
# + ~600 MiB ctranslate2 CUDA workspace peak) = ~10,418 MiB → total ~20,783 MiB,
# leaving ~2,251 MiB free. The extra headroom vs 0.55 (which left only ~570 MiB)
# is required for Whisper's encoder working buffers during first inference;
# without it the STT server OOMs on every transcription request.
# KV cache at 0.45 ≈ 6,200 MiB @ max_model_len=4096 — adequate for sequential calls.
ExecStart=/opt/voiceos-gpu/venv/bin/vllm serve /opt/voiceos-gpu/models/qwen2.5-7b-fp8 \
  --dtype auto \
  --port 8000 \
  --max-model-len 4096 \
  --gpu-memory-utilization 0.45 \
  --served-model-name qwen2.5-7b-instruct-fp8
Restart=on-failure
RestartSec=10
# vLLM can take ~90s to warm up; do not kill during startup.
TimeoutStartSec=300
StandardOutput=append:/opt/voiceos-gpu/logs/llm.log
StandardError=append:/opt/voiceos-gpu/logs/llm.log

[Install]
WantedBy=multi-user.target
